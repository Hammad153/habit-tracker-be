generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BadgeType {
  STREAK
  MILESTONE
}

model User {
  id             String      @id @default(cuid())
  name           String
  email          String      @unique
  password       String
  refreshToken   String?
  avatar         String?
  pushToken      String?
  level          Int         @default(1)
  xp             Int         @default(0)
  longestStreak  Int         @default(0)
  totalHabits    Int         @default(0)
  completionRate Float       @default(0)
  habits         Habit[]
  badges         UserBadge[]
  reminders      Reminder[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Habit {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  title       String
  subtitle    String?
  icon        String
  iconColor   String
  iconBg      String
  category    String?
  frequency   String?      // e.g., "Daily", "Weekdays" (legacy)
  scheduleType String?     // "daily" | "specific_days" | "times_per_week" | "interval"
  scheduleDays String[]    @default([]) // e.g., ["Mon", "Wed", "Fri"]
  timesPerWeek Int?        // used when scheduleType = "times_per_week"
  intervalDays Int?        // used when scheduleType = "interval"
  priority    String?      // e.g., "High", "Medium", "Low"
  goal        Float        @default(1) // Target value (e.g., 30 pushups)
  unit        String?      @default("times") // Unit (e.g., reps, pages)
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completions Completion[]
  reminders   Reminder[]
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  time      String   // Format: HH:mm (e.g., "08:00")
  days      String[] // e.g., ["Mon", "Tue", "Wed", "Thu", "Fri"]
  enabled   Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id])
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId])
}

model Completion {
  id      String   @id @default(cuid())
  habitId String
  date    String   // Format: YYYY-MM-DD
  status  Boolean  @default(true)
  value   Float    @default(1) // Actual progress value
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

model Badge {
  id          String      @id @default(cuid())
  title       String
  description String
  icon        String
  type        BadgeType
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  badge    Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}
