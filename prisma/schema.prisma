// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BadgeType {
  STREAK
  MILESTONE
}

enum BudgetPeriodType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum DailyPlanTaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum DailyPlanTaskStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum CompletionSource {
  DAILY_PLAN
}

model User {
  id             String      @id @default(cuid())
  name           String
  email          String      @unique
  password       String
  refreshToken   String?
  resetToken     String?
  resetTokenExpiry DateTime?
  avatar         String?
  pushToken      String?
  level          Int         @default(1)
  xp             Int         @default(0)
  longestStreak  Int         @default(0)
  totalHabits    Int         @default(0)
  completionRate Float       @default(0)
  habits         Habit[]
  badges         UserBadge[]
  reminders      Reminder[]
  budgets        Budget[]
  expenses       Expense[]
  incomes        Income[]
  expenseCategories ExpenseCategory[]
  dailyPlans     DailyPlan[]
  dailyPlanTasks DailyPlanTask[]
  journalEntries JournalEntry[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

enum JournalMood {
  calm
  happy
  focused
  grateful
  tired
  stressed
  reflective
}

model JournalEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String
  // A calendar day (`YYYY-MM-DD`), not an instant. Stored as text so it round
  // trips exactly: the client groups and filters entries by this value, and a
  // DateTime would come back with a time component and a timezone to shift it.
  date        String
  mood        JournalMood
  content     String
  tags        String[]
  isFavorite  Boolean     @default(false)
  isPinned    Boolean     @default(false)
  templateId  String?
  attachments String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId, date])
}

model Habit {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  title       String
  subtitle    String?
  icon        String
  iconColor   String
  iconBg      String
  category    String?
  frequency   String?      // e.g., "Daily", "Weekdays" (legacy)
  scheduleType String?     // "daily" | "specific_days" | "times_per_week" | "interval"
  scheduleDays String[]    @default([]) // e.g., ["Mon", "Wed", "Fri"]
  timesPerWeek Int?        // used when scheduleType = "times_per_week"
  intervalDays Int?        // used when scheduleType = "interval"
  priority    String?      // e.g., "High", "Medium", "Low"
  goal        Float        @default(1) // Target value (e.g., 30 pushups)
  unit        String?      @default("times") // Unit (e.g., reps, pages)
  isArchived  Boolean      @default(false)
  startDate   DateTime?    // Optional start date for temporary habits
  endDate     DateTime?    // Optional end date - habit will be auto-deleted after this date
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  completions Completion[]
  reminders   Reminder[]
  dailyPlanTasks DailyPlanTask[]
}

model Budget {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  note      String?
  periodType BudgetPeriodType @default(MONTHLY)
  startDate DateTime
  endDate   DateTime
  expenses  Expense[]
  // Per-week rows for WEEKLY budgets. `amount` above stays the source of truth
  // for totals and is kept equal to the sum of these rows.
  breakdowns BudgetBreakdown[]
  // Optional per-category planning for MONTHLY / CUSTOM budgets.
  allocations BudgetCategoryAllocation[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, startDate, endDate])
  @@index([userId, periodType, startDate, endDate])
}

model BudgetBreakdown {
  id        String   @id @default(cuid())
  budgetId  String
  budget    Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  label     String   // e.g. "Week 1"
  startDate DateTime
  endDate   DateTime
  amount    Float
  note      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId, sortOrder])
}

model BudgetCategoryAllocation {
  id         String          @id @default(cuid())
  budgetId   String
  budget     Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Float
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([budgetId, categoryId])
  @@index([budgetId])
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String?
  color     String?
  isDefault Boolean   @default(false)
  expenses  Expense[]
  allocations BudgetCategoryAllocation[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, name])
  @@index([isDefault])
}

model Expense {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgetId    String?
  budget      Budget?         @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  title       String
  amount      Float
  note        String?
  expenseDate DateTime
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, expenseDate])
  @@index([userId, budgetId, expenseDate])
  @@index([budgetId])
  @@index([categoryId])
}

model Income {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  amount     Float
  incomeDate DateTime
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, incomeDate])
}

model DailyPlan {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDate  DateTime
  title     String?
  note      String?
  tasks     DailyPlanTask[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, planDate])
  @@index([userId, planDate])
}

model DailyPlanTask {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyPlanId String
  dailyPlan   DailyPlan           @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  habitId     String?
  habit       Habit?              @relation(fields: [habitId], references: [id], onDelete: SetNull)
  title       String
  description String?
  priority    DailyPlanTaskPriority @default(MEDIUM)
  status      DailyPlanTaskStatus   @default(PENDING)
  startTime   String?
  endTime     String?
  durationMinutes Int?
  completedAt DateTime?
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([dailyPlanId, sortOrder])
  @@index([habitId])
  @@index([habitId, status])
}

model Reminder {
  id        String   @id @default(cuid())
  userId    String
  habitId   String
  time      String   // Format: HH:mm (e.g., "08:00")
  days      String[] // e.g., ["Mon", "Tue", "Wed", "Thu", "Fri"]
  enabled   Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id])
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId])
}

model Completion {
  id      String   @id @default(cuid())
  habitId String
  date    String   // Format: YYYY-MM-DD
  status  Boolean  @default(true)
  value   Float    @default(1) // Actual progress value
  source  CompletionSource?
  sourceReferenceId String?
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([source, sourceReferenceId])
}

model Badge {
  id          String      @id @default(cuid())
  title       String
  description String
  icon        String
  type        BadgeType
  users       UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  badge    Badge    @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}
