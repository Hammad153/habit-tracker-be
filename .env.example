# ---------------------------------------------------------------------------
# Habit Tracker API — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# JWT access token — use a long random string (>= 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="1h"

# JWT refresh token — MUST be a different secret from JWT_SECRET (>= 32 chars).
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Comma-separated CORS allow-list for web clients (optional).
# Leave empty for native mobile only. Example: https://app.example.com,https://admin.example.com
CORS_ORIGINS=""

PORT=3000

# ---------------------------------------------------------------------------
# Email / SMTP settings (for password reset & transactional emails)
# ---------------------------------------------------------------------------
# SMTP server hostname (e.g. smtp.gmail.com, smtp.mailgun.org, smtp.resend.com)
MAIL_HOST="smtp.gmail.com"
# SMTP port (typically 587 for TLS, 465 for SSL, or 1025 for local mailhog)
MAIL_PORT=587
# SMTP username / full email address used to send emails
MAIL_USERNAME="your-email@gmail.com"
# SMTP password or app-specific password
MAIL_PASSWORD="your-app-password"
# The "From" name shown in email clients
APP_NAME="Habit Tracker"
# Fallback sender address when `from` is not specified in the email payload
DEFAULT_EMAIL_FROM="Habit Tracker <noreply@habittracker.app>"

# ---- Phase 3.3 NVIDIA AI Coach (optional; product works without it) ----
# The provider activates only when BOTH key and model are set.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL=""   # e.g. meta/llama-3.1-8b-instruct — configurable without code changes
NVIDIA_TIMEOUT_MS=4000
NVIDIA_MAX_TOKENS=160
