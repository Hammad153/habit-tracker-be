# ---------------------------------------------------------------------------
# Habit Tracker API — environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# JWT access token — use a long random string (>= 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="1h"

# JWT refresh token — MUST be a different secret from JWT_SECRET (>= 32 chars).
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string-min-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS is enabled for all origins by the backend. This variable is retained for
# compatibility with existing deployments but is not currently read.
CORS_ORIGINS=""

PORT=3000

# ---------------------------------------------------------------------------
# App URLs (used for Paystack redirect callbacks)
# ---------------------------------------------------------------------------
# Deep link / web app origin the paywall redirects back to after payment.
# For local Expo: your machine's LAN IP or Expo tunnel, e.g. exp://192.168.1.20:8081
WEB_APP_URL="exp://192.168.1.20:8081"
MARKETING_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Paystack subscriptions (Phase 3.9)
# ---------------------------------------------------------------------------
# Sandbox secret (sk_test_...) from dashboard.paystack.com. API boots without
# it, but checkout returns PAYMENTS_NOT_CONFIGURED until it is valid.
PAYSTACK_SECRET_KEY=""
# Plan codes are created on dashboard.paystack.com ("Plans" tab). Leave EMPTY
# until you complete docs/PAYSTACK_SETUP.md — never invent codes. Get a plan
# code by clicking a plan → "Plan code" (e.g. PLN_xxxxxx).
PAYSTACK_BASIC_MONTHLY_PLAN_CODE=""
PAYSTACK_BASIC_ANNUAL_PLAN_CODE=""
PAYSTACK_PREMIUM_MONTHLY_PLAN_CODE=""
PAYSTACK_PREMIUM_ANNUAL_PLAN_CODE=""
# Free trial length in days (default 7). Changing it affects only new accounts.
TRIAL_DURATION_DAYS=7
# Grace window after a failed renewal before access lapses (default 3).
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
# DEV ONLY: set to true to skip the subscription paywall for all requests.
# NEVER enable this in production.
SUBSCRIPTION_DEV_BYPASS=false

# ---------------------------------------------------------------------------
# Email / SMTP settings (for password reset & transactional emails)
# ---------------------------------------------------------------------------
# SMTP server hostname (e.g. smtp.gmail.com, smtp.mailgun.org, smtp.resend.com)
MAIL_HOST="smtp.gmail.com"
# SMTP port (typically 587 for TLS, 465 for SSL, or 1025 for local mailhog)
MAIL_PORT=587
# SMTP username / full email address used to send emails
MAIL_USERNAME="your-email@gmail.com"
# SMTP password or app-specific password
MAIL_PASSWORD="your-app-password"
# The "From" name shown in email clients
APP_NAME="Habit Tracker"
# Fallback sender address when `from` is not specified in the email payload
DEFAULT_EMAIL_FROM="Habit Tracker <noreply@habittracker.app>"

# ---- Phase 3.3 NVIDIA AI Coach (optional; product works without it) ----
# The provider activates only when BOTH key and model are set.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL=""   # e.g. meta/llama-3.1-8b-instruct — configurable without code changes
NVIDIA_TIMEOUT_MS=4000
NVIDIA_MAX_TOKENS=160

# ---- Phase 3.8 optional development admin seed (seed script only) ----
# Both must be set for `pnpm prisma db seed` to create/refresh an ADMIN user.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
